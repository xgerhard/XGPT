APP_NAME=XGPT
APP_ENV=local
APP_KEY=
# Never leave this true in production — Ignition error pages dump local variables (including a
# decrypted BYO API key, if one happened to be in scope when an exception fired). See CLAUDE.md.
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Production runs MySQL (matches the pre-rewrite app's existing database) — swap to sqlite
# locally if you'd rather not run a MySQL server for development.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xgpt
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
# Encrypts the session payload at rest regardless of driver — free hardening since the Nightbot
# OAuth access token passes through session state (never persisted to a table).
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# database (not file/array) so the rate limiter and free-tier budget counters are correct under
# concurrent requests — see App\Support\FreeTierBudgetGuard.
CACHE_STORE=database

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# --- XGPT -------------------------------------------------------------

# Nightbot OAuth app (https://nightbot.tv — create a custom application).
NIGHTBOT_CLIENT_ID=
NIGHTBOT_CLIENT_SECRET=

# Free-tier fallback key (config('ai.providers.openai.key')) — used for any channel that hasn't
# set its own key. Every other enabled provider is BYO-key only, see XGPT_ENABLED_PROVIDERS.
OPENAI_API_KEY=

# Comma-separated extra providers to offer in the dashboard, beyond the always-on free-tier
# OpenAI. Each needs its own *_API_KEY below if enabled. See config/xgpt.php.
XGPT_ENABLED_PROVIDERS=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

XGPT_RATE_LIMIT_PER_CHANNEL=20
XGPT_RATE_LIMIT_PER_IP=60
XGPT_FREE_TIER_DAILY_LIMIT=2000
XGPT_HISTORY_WINDOW_MINUTES=5
XGPT_HISTORY_MAX_MESSAGES=10
XGPT_MESSAGE_RETENTION_DAYS=1
